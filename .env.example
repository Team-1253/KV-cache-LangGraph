# --- LLM (GPT-5.6 Luna) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=25000

ANTHROPIC_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=LangGraph-Tutorial

# --- Web Search (Tavily) ---
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_CHUNKS_PER_SOURCE=3
TAVILY_TOPIC=general
TAVILY_LANGUAGE=en
TAVILY_INCLUDE_PUBLISHED_DATE=true
# 하드 최신 필터 미사용: 기술이 모두 2024년 이후라 time_range 제외

# --- Evaluation ---
EVAL_AS_OF=
